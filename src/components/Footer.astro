---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, getLocale } from '../i18n/utils';

const lang = getLocale(Astro.currentLocale);
const t = useTranslations(lang);
---

<footer class="border-t border-rule">
	<div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-6 px-6 pt-10 pb-12 sm:flex-row sm:items-center">
		<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
			<a href={getRelativeLocaleUrl(lang, '/')} aria-label="Plannify"><img src="/images/logo.png" alt="Plannify" class="h-4" /></a>
			<p class="font-mono text-xs text-ink-mute">{t.footer.tagline}</p>
		</div>
		<div class="flex items-center gap-6 text-sm text-ink-soft">
			<a href="https://github.com/plannify-truck-driver" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-ink">GitHub</a>
			<a href="mailto:contact@plannify.be" class="transition-colors hover:text-ink">Contact</a>
		</div>
	</div>
</footer>
